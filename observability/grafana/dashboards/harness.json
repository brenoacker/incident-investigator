{
  "title": "Investigation Harness",
  "schemaVersion": 39,
  "panels": [
    {"type":"timeseries","title":"Investigation run duration","targets":[{"expr":"histogram_quantile(0.95, sum(rate(investigation_run_duration_bucket[5m])) by (le))"}],"gridPos":{"h":8,"w":12,"x":0,"y":0}},
    {"type":"timeseries","title":"Runs and failures","targets":[{"expr":"sum(rate(investigation_runs_completed_total[5m]))","legendFormat":"completed"},{"expr":"sum(rate(investigation_runs_failed_total[5m]))","legendFormat":"failed"}],"gridPos":{"h":8,"w":12,"x":12,"y":0}},
    {"type":"timeseries","title":"MCP queries","targets":[{"expr":"sum(rate(evidence_provider_queries_total[5m])) by (provider)","legendFormat":"{{provider}}"},{"expr":"sum(rate(evidence_provider_query_failures_total[5m])) by (provider)","legendFormat":"{{provider}} failures"}],"gridPos":{"h":8,"w":12,"x":0,"y":8}},
    {"type":"timeseries","title":"Quality Gate verdicts","targets":[{"expr":"sum(rate(quality_gate_duration_count[5m])) by (verdict)","legendFormat":"{{verdict}}"}],"gridPos":{"h":8,"w":12,"x":12,"y":8}},
    {"type":"timeseries","title":"Retry Storm signals","targets":[{"expr":"sum(rate(notification_retries_total[5m]))","legendFormat":"retries"},{"expr":"notification_backlog","legendFormat":"backlog"}],"gridPos":{"h":8,"w":24,"x":0,"y":16}},
    {"type":"timeseries","title":"AI model latency and failures","targets":[{"expr":"histogram_quantile(0.95, sum(rate(investigation_model_duration_bucket[5m])) by (le, model_version))","legendFormat":"p95 {{model_version}}"},{"expr":"sum(rate(investigation_model_executions_total{outcome=\"failure\"}[5m])) by (failure_category)","legendFormat":"failure {{failure_category}}"}],"gridPos":{"h":8,"w":12,"x":0,"y":24}},
    {"type":"timeseries","title":"AI usage and cost","targets":[{"expr":"sum(rate(investigation_model_input_tokens_total[5m]))","legendFormat":"input tokens"},{"expr":"sum(rate(investigation_model_output_tokens_total[5m]))","legendFormat":"output tokens"},{"expr":"sum(rate(investigation_model_cost_total[5m]))","legendFormat":"estimated cost"}],"gridPos":{"h":8,"w":12,"x":12,"y":24}},
    {"type":"timeseries","title":"Investigation outcomes and citation failures","targets":[{"expr":"sum(rate(quality_gate_verdicts_total{verdict=\"approved\"}[5m])) / clamp_min(sum(rate(quality_gate_verdicts_total[5m])), 1)","legendFormat":"approval rate"},{"expr":"sum(rate(quality_gate_citation_failures_total[5m])) by (reason)","legendFormat":"citation {{reason}}"}],"gridPos":{"h":8,"w":24,"x":0,"y":32}}
  ]
}
